# Copy to .env for local development (frontend/.env is git-ignored).
#
# All VITE_* vars are BUILD-TIME: Vite inlines them into the bundle, so they
# are public — never put secrets here.
#
# The video vars below are REQUIRED and have no in-code fallback, so dev, test,
# and build all need them. Copy this file to .env locally; CI and deploys must
# inject the VITE_* vars (or provide a .env) at build time, or the build and
# the video upload tests will fail.

# Backend the Vite dev proxy forwards /api and /auth to (optional; default shown).
# VITE_API_PROXY_TARGET=http://localhost:8080

# Base URL the SPA prefixes onto API calls. Empty = same-origin via the dev proxy.
# VITE_API_BASE_URL=

# Set-video upload UX hints. Keep in sync with the backend MAX_VIDEO_BYTES /
# accepted content types — the server enforces the real limits regardless.
VITE_MAX_VIDEO_BYTES=524288000
VITE_ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/webm
