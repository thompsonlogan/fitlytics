# Copy to .env for local development. .env is git-ignored.
#
# All VITE_* vars are BUILD-TIME: Vite inlines them into the bundle at build,
# so they are public — never put secrets here. All are optional; the defaults
# shown below are applied when a var is unset.

# Backend that the Vite dev proxy forwards /api and /auth to.
# VITE_API_PROXY_TARGET=http://localhost:8080

# Base URL the SPA prefixes onto API calls. Empty = same-origin (relative),
# which routes through the dev proxy above. Set only for a cross-origin API.
# VITE_API_BASE_URL=

# Set-video upload UX hints. The backend enforces the real limits regardless;
# these only drive the client-side validation message and the dropzone caption.
# Keep them in sync with the backend MAX_VIDEO_BYTES / accepted types.
# VITE_MAX_VIDEO_BYTES=524288000                                # 500 MB
# VITE_ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/webm
