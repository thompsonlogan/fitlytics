# Build-time config for the SPA (Vite VITE_*). Committed because these are
# public, non-secret values inlined into the bundle at build time. Put local
# overrides (and anything secret) in .env.local, which is git-ignored.

# Backend the dev proxy forwards /api and /auth to (optional; default shown).
# VITE_API_PROXY_TARGET=http://localhost:8080

# Base URL the SPA prefixes onto API calls. Empty = same-origin via the dev
# proxy. Set only for a cross-origin API.
# VITE_API_BASE_URL=

# Set-video upload UX hints. Keep in sync with the backend MAX_VIDEO_BYTES /
# accepted content types — the server enforces the real limits regardless.
VITE_MAX_VIDEO_BYTES=524288000
VITE_ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/webm
