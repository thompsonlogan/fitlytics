# Copy to .env for local development. .env is git-ignored.

APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info

# Matches database/docker-compose.yml (user/password/db all `fitlytics`).
# search_path is pinned to `fitlytics, public` on the database itself by
# V1__001_init.sql, so unqualified table names resolve to the fitlytics schema.
DATABASE_URL=postgres://fitlytics:fitlytics@localhost:5432/fitlytics?sslmode=disable

# WorkOS credentials — from the WorkOS dashboard (API Keys / Configuration).
# Real values start with sk_test_ / sk_live_ (api key) and client_ (client id);
# the placeholders below are deliberately non-matching to avoid tripping
# GitHub's secret scanning on commit.
WORKOS_API_KEY=your-workos-api-key
WORKOS_CLIENT_ID=your-workos-client-id

# Absolute URL of the /auth/callback endpoint on this backend. WorkOS will
# redirect here with an authorization code after the user signs in. Must be
# registered in the WorkOS dashboard under Configuration → Redirects.
WORKOS_REDIRECT_URI=http://localhost:8080/auth/callback

# Absolute URL of the SPA root. The /auth/callback handler bounces the
# browser back here after a successful exchange, and a failed callback
# appends ?auth_error=... to this URL for the SPA to surface.
APP_URL=http://localhost:5173

# Optional. Derived from WORKOS_CLIENT_ID when blank. Override only if auth
# rejects valid tokens (decode a real token to confirm the issuer string).
# WORKOS_JWKS_URL=
# WORKOS_JWT_ISSUER=

# Optional (development only). Set to a users.id UUID to skip WorkOS JWT
# verification and authenticate every request as that local user.
# AUTH_BYPASS_USER_ID=

# ── Set video upload (Cloudflare R2) ─────────────────────────────────────────
# All four R2_* vars are required — the API fails to start if any is missing.
#
# Create a private bucket and an "Object Read & Write" R2 API token in the
# Cloudflare dashboard, then add a CORS rule allowing PUT/GET from APP_URL.
# Endpoint is the account-level S3 endpoint (no bucket name in the path) —
# the backend uses path-style addressing and appends the bucket itself.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=your-bucket-name
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Optional abuse limits — defaults shown; uncomment to override.
# MAX_VIDEO_BYTES=524288000     # per-upload cap in bytes (500 MB)
# MAX_VIDEOS_PER_USER=200       # max active videos per user
# MAX_VIDEOS_PER_DAY=50         # max uploads per rolling 24h
